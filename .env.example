# SnapCarb Health Companion - Environment Variables
# Copy this file to .env and fill in your actual values

# Gemini AI API (Required for AI meal analysis and recipe generation)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Required for database)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# USDA Nutrition Database API (Optional - for additional nutrition data)
EXPO_PUBLIC_USDA_API_KEY=your_usda_api_key_here

# Backend API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_VERSION=v1

# Google Authentication (Optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Email Service (Optional - for notifications)
EXPO_PUBLIC_RESEND_API_KEY=your_resend_api_key

# Feature Flags
EXPO_PUBLIC_AI_FEATURES_ENABLED=true
EXPO_PUBLIC_SOCIAL_FEATURES_ENABLED=true
EXPO_PUBLIC_ADVANCED_ANALYTICS_ENABLED=true

# Health Integration
EXPO_PUBLIC_HEALTH_KIT_ENABLED=false
EXPO_PUBLIC_GOOGLE_FIT_ENABLED=false

# Development
NODE_ENV=development
DEBUG=snapcarb:*
LOG_LEVEL=info

